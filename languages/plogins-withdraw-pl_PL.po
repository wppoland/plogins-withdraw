#: src/Service/WithdrawalService.php:306
msgid "This order is no longer eligible for withdrawal."
msgstr "To zamówienie nie podlega już odstąpieniu."

#: src/Service/WithdrawalService.php:315
msgid ""
"Please tick the declaration to confirm you are withdrawing from the contract."
msgstr "Zaznacz oświadczenie, aby potwierdzić, że odstępujesz od umowy."

#. translators: 1: request id, 2: item list
#: src/Service/WithdrawalService.php:356
#, php-format
msgid ""
"Withdrawal declaration #%1$d received.\n"
"%2$s"
msgstr "Otrzymano oświadczenie o odstąpieniu #%1$d.\n%2$s"

#: src/Service/WithdrawalService.php:413
msgid "Enter a valid email address."
msgstr "Podaj prawidłowy adres e-mail."

#: src/Service/WithdrawalService.php:462
msgid "This link has expired or has already been used. Request a new one."
msgstr "Ten odnośnik wygasł lub został już użyty. Poproś o nowy."

#: src/Service/WithdrawalService.php:535
msgid "We could not find an order with that number and email."
msgstr "Nie znaleźliśmy zamówienia o podanym numerze i adresie e-mail."

#: src/Service/WithdrawalService.php:733
msgid "This order is not in a status that can be withdrawn."
msgstr "To zamówienie nie ma statusu umożliwiającego odstąpienie."

#: src/Service/WithdrawalService.php:743
msgid "The withdrawal period for this order has ended."
msgstr "Okres odstąpienia od umowy dla tego zamówienia dobiegł końca."

#: src/Service/WithdrawalService.php:747
msgid "A withdrawal request for this order is already being processed."
msgstr "Wniosek o odstąpienie dla tego zamówienia jest już przetwarzany."

#: src/Service/WithdrawalService.php:758
msgid ""
"This order is for digital content you asked us to supply immediately, and "
