#: templates/form-lookup.php:50
msgid "Continue"
msgstr "Dalej"

#: templates/form-lookup.php:46
msgid "Billing email"
msgstr "Adres e-mail (rozliczeniowy)"

#: templates/form-lookup.php:42
msgid "Order number"
msgstr "Numer zamówienia"

#. translators: %d: number of days
#: templates/form-lookup.php:28
msgid "You have the right to withdraw from this contract within %d days without giving any reason."
msgstr "Mają Państwo prawo odstąpić od niniejszej umowy w terminie %d dni bez podania jakiejkolwiek przyczyny."

#: templates/form-items.php:88
msgid "Submit withdrawal"
msgstr "Złóż oświadczenie o odstąpieniu od umowy"

#: templates/form-items.php:83
msgid "I hereby give notice that I withdraw from my contract for the selected item(s)."
msgstr "Niniejszym informuję o moim odstąpieniu od umowy w zakresie wybranych pozycji."

#: templates/form-items.php:72
msgid "Reason (optional)"
msgstr "Powód (opcjonalnie)"

#. translators: %s: product
#: templates/form-items.php:64
msgid "Withdraw quantity for %s"
msgstr "Ilość objęta odstąpieniem dla %s"

#: templates/form-items.php:49
msgid "Withdraw quantity"
msgstr "Ilość objęta odstąpieniem"

#: templates/form-items.php:48
msgid "Ordered"
msgstr "Zamówiono"

#: templates/form-items.php:47
msgid "Product"
msgstr "Produkt"

#. translators: %s: date
#: templates/form-items.php:32
msgid "Withdrawal is possible until %s."
msgstr "Odstąpienie od umowy jest możliwe do %s."

#. translators: %s: order number
#: templates/form-items.php:23
msgid "Withdraw from order #%s"
msgstr "Odstąpienie od umowy dla zamówienia #%s"

#. translators: 1: request id, 2: order number
#: templates/confirmation.php:22
msgid "Your withdrawal request #%1$d for order #%2$s has been recorded. We have emailed you a confirmation and will follow up with the next steps."
msgstr "Twój wniosek o odstąpienie od umowy #%1$d dla zamówienia #%2$s został zarejestrowany. Wysłaliśmy do Ciebie e-mail z potwierdzeniem i poinformujemy o dalszych krokach."

#: templates/confirmation.php:17
msgid "Withdrawal request received"
msgstr "Wniosek o odstąpienie od umowy przyjęty"

#: src/Service/WithdrawPrivacyService.php:99
msgid "Customer personal email and reason cleared from withdrawal declarations; order references retained for statutory bookkeeping."
msgstr "Adres e-mail klienta i podany powód zostały usunięte z oświadczeń o odstąpieniu od umowy; odwołania do zamówień zachowano na potrzeby ustawowych obowiązków księgowych."

#: src/Service/WithdrawPrivacyService.php:76
msgid "Reason"
msgstr "Powód"

#: src/Service/WithdrawPrivacyService.php:74
msgid "Order ID"
msgstr "ID zamówienia"

#: src/Service/WithdrawPrivacyService.php:36
#: src/Service/WithdrawPrivacyService.php:50
#: src/Service/WithdrawPrivacyService.php:71
msgid "Withdrawal Declarations"
msgstr "Oświadczenia o odstąpieniu od umowy"

#. translators: 1: order number, 2: customer email, 3: item list, 4: reason
#: src/Service/WithdrawalService.php:251
msgid ""
"A customer submitted a withdrawal request.\n"
"\n"
"Order: #%1$s\n"
"Customer: %2$s\n"
"\n"
"Items:\n"
"%3$s\n"
"\n"
"Reason: %4$s"
msgstr "Klient złożył wniosek o odstąpienie od umowy.\n\nZamówienie: #%1$s\nKlient: %2$s\n\nPozycje:\n%3$s\n\nPowód: %4$s"

#. translators: 1: request id, 2: order number
#: src/Service/WithdrawalService.php:245
msgid "New withdrawal request #%1$d for order #%2$s"
msgstr "Nowy wniosek o odstąpienie od umowy #%1$d dla zamówienia #%2$s"

#: src/Service/WithdrawalService.php:237 src/Service/WithdrawalService.php:255
msgid "(none given)"
msgstr "(nie podano)"

#. translators: 1: order number, 2: item list, 3: reason
#: src/Service/WithdrawalService.php:234
msgid ""
"We received your withdrawal request for order #%1$s.\n"
"\n"
"Items:\n"
"%2$s\n"
"\n"
"Reason: %3$s\n"
"\n"
"We will confirm the next steps by email."
msgstr "Otrzymaliśmy Twój wniosek o odstąpienie od umowy dla zamówienia #%1$s.\n\nPozycje:\n%2$s\n\nPowód: %3$s\n\nDalsze kroki potwierdzimy e-mailem."

#. translators: %s: order number
#: src/Service/WithdrawalService.php:229
msgid "Your withdrawal request for order #%s"
msgstr "Twój wniosek o odstąpienie od umowy dla zamówienia #%s"

#: src/Service/WithdrawalService.php:210
msgid "A withdrawal request for this order is already being processed."
msgstr "Wniosek o odstąpienie od umowy dla tego zamówienia jest już przetwarzany."

#: src/Service/WithdrawalService.php:206
msgid "The withdrawal period for this order has ended."
msgstr "Termin na odstąpienie od umowy dla tego zamówienia już minął."

#: src/Service/WithdrawalService.php:196
msgid "This order is not in a status that can be withdrawn."
msgstr "To zamówienie nie ma statusu, który umożliwia odstąpienie od umowy."

#: src/Service/WithdrawalService.php:150
msgid "Please select at least one item to withdraw from."
msgstr "Wybierz co najmniej jedną pozycję, której ma dotyczyć odstąpienie od umowy."

#: src/Service/WithdrawalService.php:125
msgid "This order is no longer eligible for withdrawal."
msgstr "To zamówienie nie kwalifikuje się już do odstąpienia od umowy."

#: src/Service/WithdrawalService.php:92 src/Service/WithdrawalService.php:122
msgid "We could not find an order with that number and email."
msgstr "Nie znaleźliśmy zamówienia o podanym numerze i adresie e-mail."

#: src/Service/WithdrawalService.php:84 src/Service/WithdrawalService.php:115
msgid "Security check failed. Please try again."
msgstr "Weryfikacja bezpieczeństwa nie powiodła się. Spróbuj ponownie."

#: src/Frontend/MyAccount.php:46
msgid "Withdraw from this order"
msgstr "Odstąp od tego zamówienia"

#: src/Admin/Settings.php:203
msgid "Shown on the form. Adapt to the statutory model withdrawal form (Annex I.B)."
msgstr "Wyświetlany w formularzu. Dostosuj do ustawowego wzoru formularza odstąpienia od umowy (załącznik I.B, w Polsce załącznik nr 2 do ustawy o prawach konsumenta)."

#: src/Admin/Settings.php:202
msgid "Model withdrawal text"
msgstr "Wzór formularza odstąpienia od umowy"

#: src/Admin/Settings.php:198
msgid "Shown above the order lookup step of the withdrawal form."
msgstr "Wyświetlany nad krokiem wyszukiwania zamówienia w formularzu odstąpienia od umowy."

#: src/Admin/Settings.php:197
msgid "Form intro text"
msgstr "Tekst wprowadzający formularza"

#: src/Admin/Settings.php:194
msgid "Legal texts"
msgstr "Teksty prawne"

#: src/Admin/Settings.php:188
msgid "Where new-request notifications are sent. Leave empty to use the site admin email. The customer always gets a confirmation at their own address."
msgstr "Adres, na który trafiają powiadomienia o nowych wnioskach. Pozostaw puste, aby użyć adresu e-mail administratora witryny. Klient zawsze otrzymuje potwierdzenie na swój adres."

#: src/Admin/Settings.php:186
msgid "Notification email"
msgstr "E-mail powiadomień"

#: src/Admin/Settings.php:183
msgid "Emails"
msgstr "E-maile"

#: src/Admin/Settings.php:178
msgid "No status checked: Completed and Processing will be saved instead."
msgstr "Nie zaznaczono żadnego statusu: zapisane zostaną Zrealizowane i W trakcie realizacji."

#: src/Admin/Settings.php:165
msgid "Customers can only submit a withdrawal for orders in one of these statuses. If none are checked, Completed and Processing are used."
msgstr "Klienci mogą złożyć oświadczenie o odstąpieniu od umowy tylko dla zamówień o jednym z tych statusów. Jeśli żaden nie jest zaznaczony, używane są Zrealizowane i W trakcie realizacji."

#: src/Admin/Settings.php:164
msgid "Eligibility"
msgstr "Uprawnione zamówienia"

#: src/Admin/Settings.php:155
msgid "Create a page with the [withdraw_form] shortcode, then select it here so the My Account button can link to it."
msgstr "Utwórz stronę z shortcode'em [withdraw_form], a następnie wskaż ją tutaj, aby przycisk w Moim koncie mógł do niej prowadzić."

#: src/Admin/Settings.php:152
msgid "Select a page"
msgstr "Wybierz stronę"

#: src/Admin/Settings.php:146
msgid "Withdrawal form page"
msgstr "Strona formularza odstąpienia od umowy"

#: src/Admin/Settings.php:143
msgid "Form page"
msgstr "Strona formularza"

#: src/Admin/Settings.php:137
msgid "Statutory minimum is 14 days from delivery. The window starts when the order is marked completed, or at order creation if it never was."
msgstr "Ustawowe minimum to 14 dni od dostawy. Termin biegnie od oznaczenia zamówienia jako zrealizowanego, a jeśli nigdy nie zostało zrealizowane, od utworzenia zamówienia."

#: src/Admin/Settings.php:135
msgid "Withdrawal period (days)"
msgstr "Termin na odstąpienie od umowy (dni)"

#: src/Admin/Settings.php:132
msgid "General"
msgstr "Ogólne"

#: src/Admin/Settings.php:123
msgid "View requests"
msgstr "Zobacz wnioski"

#. translators: 1: pending, 2: accepted, 3: processed, 4: rejected
#: src/Admin/Settings.php:116
msgid "%1$d pending, %2$d accepted, %3$d processed, %4$d rejected"
msgstr "%1$d oczekujących, %2$d zaakceptowanych, %3$d przetworzonych, %4$d odrzuconych"

#: src/Admin/Settings.php:112
msgid "Requests:"
msgstr "Wnioski:"

#: src/Admin/Settings.php:109
msgid "Complies with EU Directive 2023/2673 (Art. 11a): an easy withdrawal function letting customers declare a full or partial withdrawal for their orders. Requests are logged under WooCommerce → Withdrawal Requests."
msgstr "Zgodna z dyrektywą UE 2023/2673 (art. 11a): łatwa funkcja odstąpienia od umowy, która pozwala klientom zadeklarować całkowite lub częściowe odstąpienie od umowy dla swoich zamówień. Wnioski są rejestrowane w WooCommerce → Wnioski o odstąpienie od umowy."

#: src/Admin/Settings.php:108
msgid "Right of Withdrawal"
msgstr "Prawo odstąpienia od umowy"

#: src/Admin/Settings.php:35 src/Admin/Settings.php:36
msgid "Withdrawal"
msgstr "Odstąpienie od umowy"

#: src/Admin/RequestsAdmin.php:120
msgid "Save"
msgstr "Zapisz"

#: src/Admin/RequestsAdmin.php:95
msgid "No withdrawal requests yet."
msgstr "Brak wniosków o odstąpienie od umowy."

