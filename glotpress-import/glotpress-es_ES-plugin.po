#: plogins-withdraw.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#. Author of the plugin
#: plogins-withdraw.php
msgid "WPPoland"
msgstr "WPPoland"

#. Description of the plugin
#: plogins-withdraw.php
msgid "EU right-of-withdrawal button and form (Directive 2023/2673, Art. 11a): let customers submit full or partial withdrawal requests for their orders, with an admin log and email notifications."
msgstr "Botón y formulario de desistimiento de la UE (Directiva 2023/2673, art. 11a): permite a los clientes enviar solicitudes de desistimiento total o parcial de sus pedidos, con un registro en el administrador y notificaciones por correo electrónico."

#. Plugin URI of the plugin
#: plogins-withdraw.php
msgid "https://plogins.com/plogins-withdraw/"
msgstr "https://plogins.com/plogins-withdraw/"

#. Plugin Name of the plugin
#: plogins-withdraw.php
msgid "Plogins Withdraw - Right of Withdrawal Button for WooCommerce"
msgstr "Plogins Withdraw - botón de desistimiento para WooCommerce"